import java.util.HashSet;
import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int year = sc.nextInt();

        while (true) {
            year++;

            HashSet<Integer> set = new HashSet<>();

            int temp = year;

            while (temp > 0) {
                set.add(temp % 10);
                temp /= 10;
            }

            if (set.size() == 4) {
                System.out.println(year);
                break;
            }
        }

        sc.close();
    }
}

import java.util.Scanner;
 
public class Main{
    public static void main(String [] args){
        Scanner sc=new Scanner(System.in);
        
        String s=sc.next();
        int a=0,b=0;
        for(int i=0;i<s.length();i++){
            int c= s.charAt(i);
            if(c>64 && c<91){
                a++;
            }else{
                b++;
            }
        }
        if(a>b){
            System.out.println(s.toUpperCase());
        }else{
            System.out.println(s.toLowerCase());
        }
        
        sc.close();
    }
}

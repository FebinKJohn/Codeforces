
import java.util.Scanner;
 
public class Main{
    public static void main(String [] args){
        Scanner sc=new Scanner(System.in);
        
        String s=sc.next().toLowerCase();
        String st="";
        
        for(int i=0;i<s.length();i++){
            char ch = s.charAt(i);
            if(ch !='a' && ch !='e' && ch!= 'i' && ch!='o' && ch!='u' && ch!='y'){
                st+="."+ch;
            }
        }
        System.out.println(st);
        
        sc.close();
    }
}
